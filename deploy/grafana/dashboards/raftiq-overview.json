        {
          "expr": "raftiq_raft_last_applied",
          "legendFormat": "applied {{node_id}}",
          "refId": "B"
        },
        {
          "expr": "raftiq_raft_last_log_index",
          "legendFormat": "log {{node_id}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
